<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Copa 2026</title>

    <style>
        body {
            font-family: Arial;
            background: #f2f2f2;
            text-align: center;
        }

        .box {
            background: white;
            padding: 20px;
            margin: 50px auto;
            width: 60%;
            border-radius: 10px;
            box-shadow: 0px 0px 10px #ccc;
        }

        a {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 20px;
            background: green;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }
    </style>
</head>

<body>

    <div class="box">

        <h1><%= evento.nome %></h1>

        <p><strong>Local:</strong> <%= evento.local %></p>
        <p><strong>Data:</strong> <%= evento.data %></p>
        <p><strong>Horário:</strong> <%= evento.horario %></p>
        <p><%= evento.descricao %></p>

        <a href="<%= evento.cadastro %>">
            Cadastro das Seleções
        </a>

    </div>

</body>

</html>