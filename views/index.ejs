<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Copa do Mundo 2026</title>

    <style>

        body{
            font-family: Arial;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .container{
            width: 80%;
            margin: auto;
            margin-top: 50px;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px gray;
        }

        h1{
            color: green;
            text-align: center;
        }

        p{
            font-size: 18px;
        }

        .botao{
            display: inline-block;
            margin-top: 20px;
            padding: 15px 25px;
            background: green;
            color: white;
            text-decoration: none;
            border-radius: 5px;
        }

        .botao:hover{
            background: darkgreen;
        }

    </style>

</head>

<body>

    <div class="container">

        <h1><%= evento.nome %></h1>

        <p>
            <strong>Local:</strong>
            <%= evento.local %>
        </p>

        <p>
            <strong>Data:</strong>
            <%= evento.data %>
        </p>

        <p>
            <strong>Horário:</strong>
            <%= evento.horario %>
        </p>

        <p>
            <strong>Descrição:</strong>
            <%= evento.descricao %>
        </p>

        <a class="botao"
           href="<%= evento.cadastro %>">

           Cadastro das Seleções

        </a>

    </div>

</body>

</html>